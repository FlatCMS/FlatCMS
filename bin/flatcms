declare(strict_types=1);

$base = dirname(__DIR__);
try {
    foreach (['StorageException', 'StoragePathGuard', 'ApplicationLock'] as $class) {
        require_once $base . '/app/Core/Storage/' . $class . '.php';
    }
    $command = (string) ($argv[1] ?? 'help');
    $diagnostic = in_array($command, ['doctor', 'storage:verify', 'help', '--help', '-h'], true);
    \App\Core\Storage\ApplicationLock::for($base)->enter(250, $diagnostic || $command === 'storage:repair', $diagnostic);
} catch (Throwable) {
    fwrite(STDERR, json_encode(['ok' => false, 'error' => 'runtime_unavailable']) . PHP_EOL);
    exit(2);
}
require_once $base . '/app/Core/EnvironmentFile.php';
foreach ([$base . '/.env', $base . '/.env.local'] as $envFile) {
    \App\Core\EnvironmentFile::load($envFile);
}

define('BASE_PATH', $base);
define('APP_PATH', BASE_PATH . '/app');
define('PUBLIC_PATH', BASE_PATH . '/public');
define('DATA_PATH', BASE_PATH . '/data');
define('STORAGE_PATH', BASE_PATH . '/storage');
define('CONFIG_PATH', BASE_PATH . '/config');

require_once APP_PATH . '/Bootstrap/Autoloader.php';
date_default_timezone_set((string) env('APP_TIMEZONE', 'Europe/Paris'));
\App\Core\I18n::init((string) env('APP_LOCALE', 'fr-FR'));

exit(\App\Core\Console\Application::commands()->run(array_slice($argv, 1), STDIN, STDOUT, STDERR));
